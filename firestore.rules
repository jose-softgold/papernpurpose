rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }
    function isWorker() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker';
    }

    function onlyStatusChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'statusHistory']);
    }
    function workerAllowedTransition() {
      return (resource.data.status == 'CONFIRMED' && request.resource.data.status == 'IN_PRODUCTION') ||
             (resource.data.status == 'IN_PRODUCTION' && request.resource.data.status == 'READY') ||
             (resource.data.status == 'READY' && request.resource.data.status == 'DISPATCHED');
    }
    function onlyShipmentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shipment', 'updatedAt']);
    }
    function workerCanUpdateShipment() {
      return resource.data.status in ['READY', 'DISPATCHED', 'DELIVERED'];
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if request.auth != null && isOwner();
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && (
        isOwner() ||
        (isWorker() && resource.data.status in ['CONFIRMED', 'IN_PRODUCTION', 'READY', 'DISPATCHED', 'DELIVERED', 'COMPLETED'])
      );
      allow create: if request.auth != null && isOwner();
      allow update: if request.auth != null && (
        isOwner() ||
        (isWorker() && onlyStatusChange() && workerAllowedTransition()) ||
        (isWorker() && onlyShipmentUpdate() && workerCanUpdateShipment())
      );
      allow delete: if false;
    }

    match /orders/{orderId}/items/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwner();
    }

    // Top-level orderItems collection (actual storage path used by getItems)
    match /orderItems/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwner();
    }

    // Products and versions: workers can read (need to know what they're making)
    match /products/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwner();
    }
    match /productVersions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwner();
    }

    // Suppliers: workers can read and create
    match /suppliers/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isOwner();
    }

    // Materials: workers can read and create
    match /materials/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isOwner();
    }

    // Purchases: workers can read and create
    match /purchases/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isOwner();
    }
    match /purchaseItems/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isOwner();
    }

    // Production: workers can read and create
    match /production/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isOwner();
    }
    match /productionMaterials/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isOwner();
    }

    // inventoryTransactions: all authenticated can read (workers need stock levels) and create
    match /inventoryTransactions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // All other collections: owner only
    match /{collection}/{docId} {
      allow read, write: if request.auth != null && isOwner();
    }
  }
}
