# Copy to functions/gmail.env.local (gitignored) and fill in values.
# Do NOT commit real secrets.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must match an Authorized redirect URI on your OAuth Web client exactly:
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:5001/demo-project/asia-south1/gmailOAuthCallback
