{
  "name": "party-craft-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:up": "bash scripts/dev-up.sh",
    "build": "tsc -b && vite build",
    "build:functions": "npm --prefix functions run build",
    "emulators": "firebase emulators:start --project demo-project --only auth,functions,firestore,storage",
    "emulators:persist": "firebase emulators:start --project demo-project --only auth,functions,firestore,storage --import=./emulator-data --export-on-exit=./emulator-data",
    "lint": "eslint .",
    "preview": "vite preview",
    "rules:check": "node scripts/rules-check.mjs",
    "seed": "FIRESTORE_EMULATOR_HOST=localhost:8180 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 ts-node --project scripts/tsconfig.json scripts/seed.ts",
    "deploy:hosting": "firebase deploy --only hosting:app"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.27.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
